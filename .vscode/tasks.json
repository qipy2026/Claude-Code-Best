      "args": [
        "--inspect-brk=127.0.0.1:6499/test",
        "--feature",
        "BUDDY",
        "--feature",
        "TRANSCRIPT_CLASSIFIER",
        "--feature",
        "BRIDGE_MODE",
        "--feature",
        "AGENT_TRIGGERS_REMOTE",
        "--feature",
        "CHICAGO_MCP",
        "--feature",
        "VOICE_MODE",
        "--feature",
        "SHOT_STATS",
        "--feature",
        "PROMPT_CACHE_BREAK_DETECTION",
        "--feature",
        "TOKEN_BUDGET",
        "--feature",
        "AGENT_TRIGGERS",
        "--feature",
        "ULTRATHINK",
        "--feature",
        "BUILTIN_EXPLORE_PLAN_AGENTS",
        "--feature",
        "LODESTONE",
        "--feature",
        "EXTRACT_MEMORIES",
        "--feature",
        "VERIFICATION_AGENT",
        "--feature",
        "KAIROS_BRIEF",
        "--feature",
        "AWAY_SUMMARY",
        "--feature",
        "ULTRAPLAN",
        "--feature",
        "DAEMON",
        "--feature",
        "ACP",
        "--feature",
        "WORKFLOW_SCRIPTS",
