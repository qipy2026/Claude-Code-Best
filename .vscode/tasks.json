        "--feature",
        "BG_SESSIONS",
        "--feature",
        "TEMPLATES",
        "--feature",
        "CONNECTOR_TEXT",
        "--feature",
        "COMMIT_ATTRIBUTION",
        "--feature",
        "DIRECT_CONNECT",
        "--feature",
        "EXPERIMENTAL_SKILL_SEARCH",
        "--feature",
        "EXPERIMENTAL_SEARCH_EXTRA_TOOLS",
        "--feature",
        "POOR",
        "--feature",
        "SSH_REMOTE",
        "--feature",
        "AUTOFIX_PR",
        "scripts/dev-cli.ts"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "bun",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Bun Inspector|Listening:",
          "endsPattern": "ws://127\\.0\\.0\\.1:6499/test"
        }
      }
    },
