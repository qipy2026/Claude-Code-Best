{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/test",
      "stopOnEntry": true,
      "name": "★ Attach REPL → query.ts (首选)",
      "preLaunchTask": "bun: inspect-brk dev-cli (REPL)"
    },
    {
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/test",
      "stopOnEntry": true,
      "name": "★ Attach pipe (-p) → query.ts",
      "preLaunchTask": "bun: inspect-brk dev-cli (pipe)"
    },
    {
      "type": "bun",
      "request": "attach",
      "url": "ws://127.0.0.1:6499/test",
      "stopOnEntry": true,
      "name": "Attach: 手动 (先 bun run dev:inspect)"
    },
    {
      "type": "bun",
      "request": "launch",
      "runtime": "${env:USERPROFILE}\\.bun\\bin\\bun.exe",
      "runtimeArgs": [
        "--inspect-wait",
        "--feature",
        "BUDDY",
        "--feature",
        "TRANSCRIPT_CLASSIFIER",
        "--feature",
        "BRIDGE_MODE",
        "--feature",
        "AGENT_TRIGGERS_REMOTE",
        "--feature",
        "CHICAGO_MCP",
        "--feature",
        "VOICE_MODE",
        "--feature",
        "SHOT_STATS",
        "--feature",
        "PROMPT_CACHE_BREAK_DETECTION",
        "--feature",
        "TOKEN_BUDGET",
        "--feature",
        "AGENT_TRIGGERS",
        "--feature",
        "ULTRATHINK",
        "--feature",
        "BUILTIN_EXPLORE_PLAN_AGENTS",
        "--feature",
        "LODESTONE",
        "--feature",
        "EXTRACT_MEMORIES",
        "--feature",
        "VERIFICATION_AGENT",
        "--feature",
        "KAIROS_BRIEF",
        "--feature",
        "AWAY_SUMMARY",
        "--feature",
        "ULTRAPLAN",
        "--feature",
        "DAEMON",
        "--feature",
        "ACP",
        "--feature",
        "WORKFLOW_SCRIPTS",
        "--feature",
        "MONITOR_TOOL",
        "--feature",
        "KAIROS",
        "--feature",
        "COORDINATOR_MODE",
        "--feature",
        "BG_SESSIONS",
        "--feature",
        "TEMPLATES",
        "--feature",
        "CONNECTOR_TEXT",
        "--feature",
        "COMMIT_ATTRIBUTION",
        "--feature",
        "DIRECT_CONNECT",
        "--feature",
        "EXPERIMENTAL_SKILL_SEARCH",
        "--feature",
        "EXPERIMENTAL_SEARCH_EXTRA_TOOLS",
        "--feature",
        "POOR",
        "--feature",
        "SSH_REMOTE",
        "--feature",
        "AUTOFIX_PR"
      ],
      "program": "${workspaceFolder}/scripts/dev-cli.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "production"
      },
      "strictEnv": false,
      "watchMode": false,
      "stopOnEntry": true,
      "noDebug": false,
      "name": "Launch inspect-wait REPL"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Smoke: debugger 是否工作",
      "runtime": "${env:USERPROFILE}\\.bun\\bin\\bun.exe",
      "runtimeArgs": ["--inspect-wait"],
      "program": "${workspaceFolder}/scripts/debug-smoke.ts",
      "cwd": "${workspaceFolder}",
      "stopOnEntry": true,
      "noDebug": false
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Test: 当前测试文件",
      "runtime": "${env:USERPROFILE}\\.bun\\bin\\bun.exe",
      "program": "${file}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
